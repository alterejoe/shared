package components
import "{{ .StructsImport }}"
{{ range .Component.Variants }}
templ {{ .Name }}LinkButton(props *structs.{{ $.Struct.Name }}) {
     <a	
		if props.ID != "" {
			id={ props.ID }
		}
		if props.Href != "" {
			href={ templ.SafeURL(props.Href) }
		}
		class="py-2 px-4 text-xl cursor-pointer transition-colors {{ .Props.bgClass }} hover:{{ .Props.bgClass }}/90"
	>
		if props.Value != "" {
			{ props.Value }
		} else {
			{ children... }
		}
	</a>
}
{{ end }}
