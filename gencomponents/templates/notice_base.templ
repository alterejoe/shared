package components
import "{{ .StructsImport }}"

{{ range .Component.Variants }}
templ Notice{{ .Name }}(props *structs.{{ $.Struct.Name }}) {
	<h5
		if props.ID != "" {
			id={ props.ID }
		}
		if props.Name != "" {
			name={ props.Name }
		}
		class="p-3 text-center justify-center flex {{ .Props.bgClass }}"
	>
		if props.Value != "" {
			if props.Align() {
				{ props.Value }
				{ children... }
			} else {
				{ children... }
				{ props.Value }
			}
		} else {
			{ children... }
		}
	</h5>
}

{{ end }}
