package components

import "github.com/alterejoe/shared/structs"

templ selectBase(props *structs.Select, bgClass string, borderClass string, textClass string) {
	<select
		if props.ID != "" {
			id={ props.ID }
		}
		if props.Name != "" {
			name={ props.Name }
		}
		if props.Disabled {
			disabled
		}
		if props.Required {
			required
		}
		class={ "text-lg p-2 rounded w-full cursor-pointer focus:outline-none " + bgClass + " " + borderClass + " " + textClass }
		if props.FormBehaviors.ConstraintString() != "" {
			data-constraint={ props.FormBehaviors.ConstraintString() }
		}
		if props.FormBehaviors.DirtyWatch {
			data-dirty-watch="true"
		}
		if props.FormBehaviors.DirtyGroup != "" {
			data-dirty-group={ props.FormBehaviors.DirtyGroup }
		}
		if props.Hx.Method == structs.GET {
			hx-get={ props.Hx.URL }
		}
		if props.Hx.Method == structs.POST {
			hx-post={ props.Hx.URL }
		}
		if props.Hx.Method == structs.PUT {
			hx-put={ props.Hx.URL }
		}
		if props.Hx.Method == structs.DELETE {
			hx-delete={ props.Hx.URL }
		}
		if props.Hx.Trigger != "" {
			hx-trigger={ props.Hx.Trigger }
		}
		if props.Hx.Target != "" {
			hx-target={ props.Hx.Target }
		}
		if props.Hx.Swap != "" {
			hx-swap={ props.Hx.Swap }
		}
		if props.Hx.Vals != "" {
			hx-vals={ props.Hx.Vals }
		}
		if props.Hx.Include != "" {
			hx-include={ props.Hx.Include }
		}
		if props.Hx.Indicator != "" {
			hx-indicator={ props.Hx.Indicator }
		}
		if props.Hx.Confirm != "" {
			hx-confirm={ props.Hx.Confirm }
		}
		if props.Hx.PushURL != "" {
			hx-push-url={ props.Hx.PushURL }
		}
	>
		{ children... }
	</select>
	if props.ID != "" {
		<div id={ props.ID + "-errors" } class="text-red-600 text-sm mt-1 hidden"></div>
	}
}

templ SelectPrimary(props *structs.Select) {
	@selectBase(props, "bg-primary", "border border-primary", "text-white") {
		{ children... }
	}
}

templ SelectSecondary(props *structs.Select) {
	@selectBase(props, "bg-secondary", "border border-secondary", "text-white") {
		{ children... }
	}
}

templ SelectTertiary(props *structs.Select) {
	@selectBase(props, "bg-tertiary", "border border-tertiary", "text-white") {
		{ children... }
	}
}

templ SelectAccent(props *structs.Select) {
	@selectBase(props, "bg-accent", "border border-accent", "text-white") {
		{ children... }
	}
}

templ SelectUnique(props *structs.Select) {
	@selectBase(props, "bg-unique", "border border-unique", "text-white") {
		{ children... }
	}
}

templ SelectAttention(props *structs.Select) {
	@selectBase(props, "bg-attention", "border border-attention", "text-white") {
		{ children... }
	}
}

templ SelectDefault(props *structs.Select) {
	@selectBase(props, "bg-white", "border border-gray-300", "text-gray-900") {
		{ children... }
	}
}
